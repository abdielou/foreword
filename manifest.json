{
  "manifest_version": 3,
  "name": "Author Lens",
  "version": "0.1.0",
  "description": "A foreword for every article: who the author is, where they come from, and what may shape their point of view.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "tabs", "alarms"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Author Lens",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/panel/panel.html", "src/panel/panel.css", "src/panel/panel.js", "src/shared/*", "icons/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
